// Purpose: Show detailed certificate information for ONLY certificates that currently exist in the Key Vault
// Problem: The runbook writes hourly snapshots, but deleted certificates remain in Log Analytics
// Solution: Select the snapshot emitted by the most recent successful runbook execution
//
// Logic:
// 1. Get the JobId of the latest successful certlcstats execution
// 2. Extract its Snapshot ID marker from the matching output stream
// 3. Select only rows carrying that SnapshotId (an empty scan returns no rows)
// 4. Calculate status and display certificate details

let LatestSuccessfulJobId = toscalar(
    AzureDiagnostics
    | where Category == "JobLogs"
    | where Resource =~ "{AutomationAccount:name}"
    | where RunbookName_s =~ tostring(split("{StatsRunbook}", "/")[-1])
    | where ResultType =~ "Completed"
    | summarize arg_max(TimeGenerated, JobId_g)
    | project JobId = tostring(JobId_g)
);

let LatestSnapshotId = toscalar(
    AzureDiagnostics
    | where Category == "JobStreams"
    | where Resource =~ "{AutomationAccount:name}"
    | where RunbookName_s =~ tostring(split("{StatsRunbook}", "/")[-1])
    | where tostring(JobId_g) == LatestSuccessfulJobId
    | where StreamType_s =~ "Output"
    | extend SnapshotId = extract(@"Snapshot ID:\s*([0-9A-Fa-f-]{36})", 1, ResultDescription)
    | where isnotempty(SnapshotId)
    | summarize arg_max(TimeGenerated, SnapshotId)
    | project SnapshotId
);

certlcstats_CL
| where SnapshotId == LatestSnapshotId
| extend LastUpdate = TimeGenerated
| extend RawTimeToExpire = Expires - now()  // timespan
| extend TimeToExpire = format_timespan(RawTimeToExpire, 'd.hh:mm:ss')  // e.g., "3.12:45:00"
| extend Status = case(
    RawTimeToExpire < 0d, "❌ Expired",
    RawTimeToExpire < 30d, "⚠️ Expiring Soon",
    "✅ OK"
)
| order by RawTimeToExpire asc  // Most urgent (expired/expiring soon) first
| project Status, LastUpdate, Name, Subject, Template, Created, Expires, TimeToExpire