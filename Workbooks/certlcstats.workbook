    {
      "content": {
        "items": [
          {
            "content": {
              "resourceType": "microsoft.resourcegraph/resources",
              "exportToExcelOptions": "all",
              "query": "{\r\n  \"headers\": [],\r\n  \"method\": \"GET\",\r\n  \"transformers\": [\r\n    {\r\n      \"settings\": {\r\n        \"tablePath\": \"$\",\r\n        \"columns\": [\r\n          {\r\n            \"columnid\": \"Queue\",\r\n            \"path\": \"$.name\"\r\n          },\r\n          {\r\n            \"columnid\": \"Approximate messages\",\r\n            \"path\": \"$.properties.approximateMessageCount\",\r\n            \"columnType\": \"long\"\r\n          }\r\n        ]\r\n      },\r\n      \"type\": \"jsonpath\"\r\n    }\r\n  ],\r\n  \"path\": \"{QueueService}/queues/certlc\",\r\n  \"version\": \"ARMEndpoint/1.0\",\r\n  \"batchDisabled\": false,\r\n  \"urlParams\": [\r\n    {\r\n      \"value\": \"2023-05-01\",\r\n      \"key\": \"api-version\"\r\n    }\r\n  ]\r\n}",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 12,
              "title": "Main queue: current backlog",
              "gridSettings": {
                "rowLimit": 1
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": []
            },
            "type": 3,
            "name": "queue-live-main",
            "customWidth": "50"
          },
          {
            "content": {
              "resourceType": "microsoft.resourcegraph/resources",
              "exportToExcelOptions": "all",
              "query": "{\r\n  \"headers\": [],\r\n  \"method\": \"GET\",\r\n  \"transformers\": [\r\n    {\r\n      \"settings\": {\r\n        \"tablePath\": \"$\",\r\n        \"columns\": [\r\n          {\r\n            \"columnid\": \"Queue\",\r\n            \"path\": \"$.name\"\r\n          },\r\n          {\r\n            \"columnid\": \"Approximate messages\",\r\n            \"path\": \"$.properties.approximateMessageCount\",\r\n            \"columnType\": \"long\"\r\n          }\r\n        ]\r\n      },\r\n      \"type\": \"jsonpath\"\r\n    }\r\n  ],\r\n  \"path\": \"{QueueService}/queues/certlc-poison\",\r\n  \"version\": \"ARMEndpoint/1.0\",\r\n  \"batchDisabled\": false,\r\n  \"urlParams\": [\r\n    {\r\n      \"value\": \"2023-05-01\",\r\n      \"key\": \"api-version\"\r\n    }\r\n  ]\r\n}",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 12,
              "title": "Poison queue: current backlog",
              "gridSettings": {
                "rowLimit": 1
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": []
            },
            "type": 3,
            "name": "queue-live-poison",
            "customWidth": "50"
          },
          {
            "content": {
              "json": "**Coverage:** Request logs reflect enabled diagnostic categories, not every queue operation. Missing records do not establish successful deletion or an empty queue. Host observations are scoped to the selected Function; age at dequeue includes retry delay."
            },
            "type": 1,
            "name": "queue-coverage"
          },
          {
            "content": {
              "parameters": [
                {
                  "version": "KqlParameterItem/1.0",
                  "jsonData": "[{\"value\":\"all\",\"label\":\"Both queues\"},{\"value\":\"certlc\",\"label\":\"certlc\"},{\"value\":\"certlc-poison\",\"label\":\"certlc-poison\"}]",
                  "label": "Queue",
                  "name": "QueueFilter",
                  "typeSettings": {
                    "showDefault": false,
                    "additionalResourceOptions": []
                  },
                  "value": "all",
                  "type": 2,
                  "id": "2ee2f53d-f75e-4282-a572-46978778e3d3"
                },
                {
                  "value": "",
                  "id": "4f51dfd6-1e0b-4859-a39d-7f846e7164a8",
                  "name": "QueueSearch",
                  "version": "KqlParameterItem/1.0",
                  "type": 1,
                  "description": "Searchable values:\n- Storage operation: PutMessage, GetMessage, UpdateMessage, DeleteMessage.\n- Storage status text: Success, ServerBusy, AuthenticationFailed.\n- Request ID, client request ID, or request path: /certlc/messages.\n- Processing attempt: message ID, Function invocation ID, or result (Failed, Succeeded, Completion not observed).\n\nEnter one value or part of a value. Matching is case-insensitive; commas and wildcards are treated literally. Each view searches its own fields, so some views may have no matches. Clear the field to show all logs for the selected queue and time range. Message contents, backlog counts and service-wide metrics are not searched.",
                  "label": "Search queue logs"
                }
              ],
              "style": "pills",
              "version": "KqlParameterItem/1.0"
            },
            "type": 9,
            "name": "queue-search"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportedParameters": [
                {
                  "parameterName": "SelectedQueueOperation",
                  "fieldName": "OperationKey",
                  "parameterType": 1
                }
              ],
              "exportToExcelOptions": "all",
              "query": "// Queue operations are requests, not unique messages. Never infer backlog from request totals.\r\nlet QueueOperations = materialize(StorageQueueLogs\r\n| where TimeGenerated {TimeRange}\r\n| where _ResourceId =~ '{QueueService}'\r\n| extend ParsedUri = parse_url(Uri)\r\n| extend Queue = tostring(split(tostring(ParsedUri.Path), '/')[1])\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| extend HttpStatus = toint(StatusCode),\r\n    RequestId = tostring(column_ifexists('RequestIdHeader', '')),\r\n    ClientRequestId = tostring(column_ifexists('ClientRequestId', '')),\r\n    Authentication = tostring(column_ifexists('AuthenticationType', '')),\r\n    Caller = tostring(column_ifexists('RequesterObjectId', ''))\r\n// Exclude URI query strings: pop receipts and signatures must not appear in workbook exports.\r\n| extend RequestPath = tostring(ParsedUri.Path), IsFailure = HttpStatus >= 400,\r\n    OperationKey = tostring(pack_array(TimeGenerated, RequestId, ClientRequestId, OperationName, tostring(ParsedUri.Path), StatusCode))\r\n| project TimeGenerated, Queue, OperationName, HttpStatus, StatusText, IsFailure,\r\n    DurationMs, ServerLatencyMs, RequestId, ClientRequestId, Authentication, Caller, RequestPath, OperationKey);\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nlet FilteredQueueOperations=QueueOperations\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or OperationName contains SearchText or StatusText contains SearchText\r\n    or RequestId contains SearchText or ClientRequestId contains SearchText or RequestPath contains SearchText;\r\nFilteredQueueOperations\r\n| where IsFailure\r\n| project Time=TimeGenerated, Queue, OperationName, HttpStatus, StatusText, DurationMs, RequestId, RequestPath, OperationKey\r\n| order by Time desc | take 200",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No failed queue requests observed in the available logs.",
              "title": "Queue request failures",
              "gridSettings": {
                "formatters": [
                  {
                    "formatter": 5,
                    "columnMatch": "OperationKey"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "RequestPath"
                  }
                ],
                "filter": true,
                "rowLimit": 10
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-failures"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportedParameters": [
                {
                  "parameterName": "SelectedQueueMessage",
                  "fieldName": "MessageId",
                  "parameterType": 1
                }
              ],
              "exportToExcelOptions": "all",
              "query": "// Host trigger records expose actual dequeue count and insertion time; storage calls do not.\r\nlet QueueTraces = materialize(AppTraces\r\n| where TimeGenerated {TimeRange} and AppRoleName =~ '{FunctionApp:name}'\r\n| extend InvocationId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\r\n| where isnotempty(InvocationId));\r\nlet QueueInvocations = QueueTraces\r\n| where Message startswith \"Executing 'Functions.QueueHandler'\" and Message contains 'New queue message detected'\r\n| extend Queue = extract(@\"New queue message detected on '([^']+)'\", 1, Message)\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| summarize Started=min(TimeGenerated) by InvocationId, Queue;\r\nlet QueueTriggerDetails = QueueTraces\r\n| where Message startswith 'Trigger Details:'\r\n| extend MessageId=extract(@'MessageId:\\s*([^,\\s]+)',1,Message),\r\n    DequeueCount=toint(extract(@'DequeueCount:\\s*(\\d+)',1,Message)),\r\n    InsertedOn=todatetime(extract(@'InsertedOn:\\s*([^,\\s]+)',1,Message))\r\n| summarize arg_min(TimeGenerated, *) by InvocationId\r\n| project InvocationId, MessageId, DequeueCount, InsertedOn;\r\nlet QueueCompletions = QueueTraces\r\n| where Message startswith \"Executed 'Functions.QueueHandler'\"\r\n| summarize arg_max(TimeGenerated, Message) by InvocationId\r\n| project InvocationId, Completed=TimeGenerated,\r\n    Result=case(Message contains '(Succeeded,', 'Succeeded', Message contains '(Failed,', 'Failed', 'Not parsed');\r\nlet QueueAttempts = QueueInvocations\r\n| join kind=leftouter QueueTriggerDetails on InvocationId\r\n| join kind=leftouter QueueCompletions on InvocationId\r\n| extend Result=coalesce(Result,'Completion not observed'),\r\n    AgeAtDequeueSeconds = datetime_diff('second', Started, InsertedOn)\r\n| project Started, Queue, MessageId, DequeueCount, AgeAtDequeueSeconds, Result, Completed, InvocationId;\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nQueueAttempts\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or MessageId contains SearchText or InvocationId contains SearchText or Result contains SearchText\r\n| where DequeueCount > 1 or Result == 'Failed'\r\n| project Started, Queue, MessageId, DequeueCount, AgeAtDequeueSeconds, Result, InvocationId\r\n| order by Started desc | take 200",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No retry or failed-completion observations in the selected Function and time range.",
              "title": "Observed message retries and failed processing",
              "gridSettings": {
                "filter": true,
                "rowLimit": 10
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-retry-summary"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportToExcelOptions": "all",
              "query": "// Queue operations are requests, not unique messages. Never infer backlog from request totals.\r\nlet QueueOperations = materialize(StorageQueueLogs\r\n| where TimeGenerated {TimeRange}\r\n| where _ResourceId =~ '{QueueService}'\r\n| extend ParsedUri = parse_url(Uri)\r\n| extend Queue = tostring(split(tostring(ParsedUri.Path), '/')[1])\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| extend HttpStatus = toint(StatusCode),\r\n    RequestId = tostring(column_ifexists('RequestIdHeader', '')),\r\n    ClientRequestId = tostring(column_ifexists('ClientRequestId', '')),\r\n    Authentication = tostring(column_ifexists('AuthenticationType', '')),\r\n    Caller = tostring(column_ifexists('RequesterObjectId', ''))\r\n// Exclude URI query strings: pop receipts and signatures must not appear in workbook exports.\r\n| extend RequestPath = tostring(ParsedUri.Path), IsFailure = HttpStatus >= 400,\r\n    OperationKey = tostring(pack_array(TimeGenerated, RequestId, ClientRequestId, OperationName, tostring(ParsedUri.Path), StatusCode))\r\n| project TimeGenerated, Queue, OperationName, HttpStatus, StatusText, IsFailure,\r\n    DurationMs, ServerLatencyMs, RequestId, ClientRequestId, Authentication, Caller, RequestPath, OperationKey);\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nlet FilteredQueueOperations=QueueOperations\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or OperationName contains SearchText or StatusText contains SearchText\r\n    or RequestId contains SearchText or ClientRequestId contains SearchText or RequestPath contains SearchText;\r\nFilteredQueueOperations\r\n| summarize Requests=count(), FailedRequests=countif(IsFailure), P95DurationMs=percentile(DurationMs,95), LastObserved=max(TimeGenerated)\r\n    by Queue, OperationName\r\n| order by Queue asc, Requests desc",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No queue operation records observed for these filters and time range.",
              "title": "Recorded queue requests",
              "gridSettings": {
                "filter": true,
                "rowLimit": 12
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-operation-summary"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportToExcelOptions": "all",
              "query": "// Queue operations are requests, not unique messages. Never infer backlog from request totals.\r\nlet QueueOperations = materialize(StorageQueueLogs\r\n| where TimeGenerated {TimeRange}\r\n| where _ResourceId =~ '{QueueService}'\r\n| extend ParsedUri = parse_url(Uri)\r\n| extend Queue = tostring(split(tostring(ParsedUri.Path), '/')[1])\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| extend HttpStatus = toint(StatusCode),\r\n    RequestId = tostring(column_ifexists('RequestIdHeader', '')),\r\n    ClientRequestId = tostring(column_ifexists('ClientRequestId', '')),\r\n    Authentication = tostring(column_ifexists('AuthenticationType', '')),\r\n    Caller = tostring(column_ifexists('RequesterObjectId', ''))\r\n// Exclude URI query strings: pop receipts and signatures must not appear in workbook exports.\r\n| extend RequestPath = tostring(ParsedUri.Path), IsFailure = HttpStatus >= 400,\r\n    OperationKey = tostring(pack_array(TimeGenerated, RequestId, ClientRequestId, OperationName, tostring(ParsedUri.Path), StatusCode))\r\n| project TimeGenerated, Queue, OperationName, HttpStatus, StatusText, IsFailure,\r\n    DurationMs, ServerLatencyMs, RequestId, ClientRequestId, Authentication, Caller, RequestPath, OperationKey);\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nlet FilteredQueueOperations=QueueOperations\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or OperationName contains SearchText or StatusText contains SearchText\r\n    or RequestId contains SearchText or ClientRequestId contains SearchText or RequestPath contains SearchText;\r\nFilteredQueueOperations\r\n| summarize Requests=count() by Time=bin(TimeGenerated,5m), Operation=strcat(Queue,' / ',OperationName)\r\n| order by Time asc",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "title": "Recorded queue request volume",
              "gridSettings": {
                "rowLimit": 500,
                "filter": true
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "timechart",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-request-trend",
            "customWidth": "50"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportToExcelOptions": "all",
              "query": "// Queue operations are requests, not unique messages. Never infer backlog from request totals.\r\nlet QueueOperations = materialize(StorageQueueLogs\r\n| where TimeGenerated {TimeRange}\r\n| where _ResourceId =~ '{QueueService}'\r\n| extend ParsedUri = parse_url(Uri)\r\n| extend Queue = tostring(split(tostring(ParsedUri.Path), '/')[1])\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| extend HttpStatus = toint(StatusCode),\r\n    RequestId = tostring(column_ifexists('RequestIdHeader', '')),\r\n    ClientRequestId = tostring(column_ifexists('ClientRequestId', '')),\r\n    Authentication = tostring(column_ifexists('AuthenticationType', '')),\r\n    Caller = tostring(column_ifexists('RequesterObjectId', ''))\r\n// Exclude URI query strings: pop receipts and signatures must not appear in workbook exports.\r\n| extend RequestPath = tostring(ParsedUri.Path), IsFailure = HttpStatus >= 400,\r\n    OperationKey = tostring(pack_array(TimeGenerated, RequestId, ClientRequestId, OperationName, tostring(ParsedUri.Path), StatusCode))\r\n| project TimeGenerated, Queue, OperationName, HttpStatus, StatusText, IsFailure,\r\n    DurationMs, ServerLatencyMs, RequestId, ClientRequestId, Authentication, Caller, RequestPath, OperationKey);\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nlet FilteredQueueOperations=QueueOperations\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or OperationName contains SearchText or StatusText contains SearchText\r\n    or RequestId contains SearchText or ClientRequestId contains SearchText or RequestPath contains SearchText;\r\nFilteredQueueOperations\r\n| summarize P95DurationMs=percentile(DurationMs,95) by Time=bin(TimeGenerated,5m),Queue\r\n| order by Time asc",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "title": "Recorded request duration (P95 milliseconds)",
              "gridSettings": {
                "rowLimit": 500,
                "filter": true
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "timechart",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-duration-trend",
            "customWidth": "50"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportedParameters": [
                {
                  "parameterName": "SelectedQueueOperation",
                  "fieldName": "OperationKey",
                  "parameterType": 1
                }
              ],
              "exportToExcelOptions": "all",
              "query": "// Queue operations are requests, not unique messages. Never infer backlog from request totals.\r\nlet QueueOperations = materialize(StorageQueueLogs\r\n| where TimeGenerated {TimeRange}\r\n| where _ResourceId =~ '{QueueService}'\r\n| extend ParsedUri = parse_url(Uri)\r\n| extend Queue = tostring(split(tostring(ParsedUri.Path), '/')[1])\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| extend HttpStatus = toint(StatusCode),\r\n    RequestId = tostring(column_ifexists('RequestIdHeader', '')),\r\n    ClientRequestId = tostring(column_ifexists('ClientRequestId', '')),\r\n    Authentication = tostring(column_ifexists('AuthenticationType', '')),\r\n    Caller = tostring(column_ifexists('RequesterObjectId', ''))\r\n// Exclude URI query strings: pop receipts and signatures must not appear in workbook exports.\r\n| extend RequestPath = tostring(ParsedUri.Path), IsFailure = HttpStatus >= 400,\r\n    OperationKey = tostring(pack_array(TimeGenerated, RequestId, ClientRequestId, OperationName, tostring(ParsedUri.Path), StatusCode))\r\n| project TimeGenerated, Queue, OperationName, HttpStatus, StatusText, IsFailure,\r\n    DurationMs, ServerLatencyMs, RequestId, ClientRequestId, Authentication, Caller, RequestPath, OperationKey);\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nlet FilteredQueueOperations=QueueOperations\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or OperationName contains SearchText or StatusText contains SearchText\r\n    or RequestId contains SearchText or ClientRequestId contains SearchText or RequestPath contains SearchText;\r\nFilteredQueueOperations\r\n| project Time=TimeGenerated, Queue, OperationName, HttpStatus, StatusText, DurationMs, Authentication, RequestId, RequestPath, OperationKey\r\n| order by Time desc | take 500",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "title": "Queue operation logs",
              "gridSettings": {
                "formatters": [
                  {
                    "formatter": 5,
                    "columnMatch": "OperationKey"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "RequestPath"
                  }
                ],
                "filter": true,
                "rowLimit": 15
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-operations"
          },
          {
            "content": {
              "showExportToExcel": true,
              "query": "// Queue operations are requests, not unique messages. Never infer backlog from request totals.\r\nlet QueueOperations = materialize(StorageQueueLogs\r\n| where TimeGenerated {TimeRange}\r\n| where _ResourceId =~ '{QueueService}'\r\n| extend ParsedUri = parse_url(Uri)\r\n| extend Queue = tostring(split(tostring(ParsedUri.Path), '/')[1])\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| extend HttpStatus = toint(StatusCode),\r\n    RequestId = tostring(column_ifexists('RequestIdHeader', '')),\r\n    ClientRequestId = tostring(column_ifexists('ClientRequestId', '')),\r\n    Authentication = tostring(column_ifexists('AuthenticationType', '')),\r\n    Caller = tostring(column_ifexists('RequesterObjectId', ''))\r\n// Exclude URI query strings: pop receipts and signatures must not appear in workbook exports.\r\n| extend RequestPath = tostring(ParsedUri.Path), IsFailure = HttpStatus >= 400,\r\n    OperationKey = tostring(pack_array(TimeGenerated, RequestId, ClientRequestId, OperationName, tostring(ParsedUri.Path), StatusCode))\r\n| project TimeGenerated, Queue, OperationName, HttpStatus, StatusText, IsFailure,\r\n    DurationMs, ServerLatencyMs, RequestId, ClientRequestId, Authentication, Caller, RequestPath, OperationKey);\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nlet FilteredQueueOperations=QueueOperations\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or OperationName contains SearchText or StatusText contains SearchText\r\n    or RequestId contains SearchText or ClientRequestId contains SearchText or RequestPath contains SearchText;\r\nlet Selection=base64_decode_tostring('{SelectedQueueOperation:base64}');\r\nFilteredQueueOperations | where isnotempty(Selection) and OperationKey == Selection\r\n| project Time=TimeGenerated, Queue, OperationName, HttpStatus, StatusText, DurationMs, ServerLatencyMs,\r\n    RequestId, ClientRequestId, Authentication, Caller, RequestPath\r\n| take 20",
              "title": "Selected queue request",
              "gridSettings": {
                "rowLimit": 500,
                "filter": true
              },
              "exportToExcelOptions": "all",
              "queryType": 0,
              "timeContextFromParameter": "TimeRange",
              "size": 3,
              "visualization": "table",
              "version": "KqlItem/1.0",
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-operation-detail",
            "conditionalVisibility": {
              "parameterName": "SelectedQueueOperation",
              "comparison": "isNotEqualTo",
              "value": ""
            }
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportedParameters": [
                {
                  "parameterName": "SelectedQueueMessage",
                  "fieldName": "MessageId",
                  "parameterType": 1
                }
              ],
              "exportToExcelOptions": "all",
              "query": "// Host trigger records expose actual dequeue count and insertion time; storage calls do not.\r\nlet QueueTraces = materialize(AppTraces\r\n| where TimeGenerated {TimeRange} and AppRoleName =~ '{FunctionApp:name}'\r\n| extend InvocationId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\r\n| where isnotempty(InvocationId));\r\nlet QueueInvocations = QueueTraces\r\n| where Message startswith \"Executing 'Functions.QueueHandler'\" and Message contains 'New queue message detected'\r\n| extend Queue = extract(@\"New queue message detected on '([^']+)'\", 1, Message)\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| summarize Started=min(TimeGenerated) by InvocationId, Queue;\r\nlet QueueTriggerDetails = QueueTraces\r\n| where Message startswith 'Trigger Details:'\r\n| extend MessageId=extract(@'MessageId:\\s*([^,\\s]+)',1,Message),\r\n    DequeueCount=toint(extract(@'DequeueCount:\\s*(\\d+)',1,Message)),\r\n    InsertedOn=todatetime(extract(@'InsertedOn:\\s*([^,\\s]+)',1,Message))\r\n| summarize arg_min(TimeGenerated, *) by InvocationId\r\n| project InvocationId, MessageId, DequeueCount, InsertedOn;\r\nlet QueueCompletions = QueueTraces\r\n| where Message startswith \"Executed 'Functions.QueueHandler'\"\r\n| summarize arg_max(TimeGenerated, Message) by InvocationId\r\n| project InvocationId, Completed=TimeGenerated,\r\n    Result=case(Message contains '(Succeeded,', 'Succeeded', Message contains '(Failed,', 'Failed', 'Not parsed');\r\nlet QueueAttempts = QueueInvocations\r\n| join kind=leftouter QueueTriggerDetails on InvocationId\r\n| join kind=leftouter QueueCompletions on InvocationId\r\n| extend Result=coalesce(Result,'Completion not observed'),\r\n    AgeAtDequeueSeconds = datetime_diff('second', Started, InsertedOn)\r\n| project Started, Queue, MessageId, DequeueCount, AgeAtDequeueSeconds, Result, Completed, InvocationId;\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{QueueSearch:base64}'));\r\nQueueAttempts\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| where isempty(SearchText) or MessageId contains SearchText or InvocationId contains SearchText or Result contains SearchText\r\n| order by Started desc | take 500",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No matching queue-trigger observations in the selected Function and time range.",
              "title": "Queue processing attempts (Function host observations)",
              "gridSettings": {
                "filter": true,
                "rowLimit": 15
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-attempts"
          },
          {
            "content": {
              "showExportToExcel": true,
              "query": "// Host trigger records expose actual dequeue count and insertion time; storage calls do not.\r\nlet QueueTraces = materialize(AppTraces\r\n| where TimeGenerated {TimeRange} and AppRoleName =~ '{FunctionApp:name}'\r\n| extend InvocationId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\r\n| where isnotempty(InvocationId));\r\nlet QueueInvocations = QueueTraces\r\n| where Message startswith \"Executing 'Functions.QueueHandler'\" and Message contains 'New queue message detected'\r\n| extend Queue = extract(@\"New queue message detected on '([^']+)'\", 1, Message)\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| summarize Started=min(TimeGenerated) by InvocationId, Queue;\r\nlet QueueTriggerDetails = QueueTraces\r\n| where Message startswith 'Trigger Details:'\r\n| extend MessageId=extract(@'MessageId:\\s*([^,\\s]+)',1,Message),\r\n    DequeueCount=toint(extract(@'DequeueCount:\\s*(\\d+)',1,Message)),\r\n    InsertedOn=todatetime(extract(@'InsertedOn:\\s*([^,\\s]+)',1,Message))\r\n| summarize arg_min(TimeGenerated, *) by InvocationId\r\n| project InvocationId, MessageId, DequeueCount, InsertedOn;\r\nlet QueueCompletions = QueueTraces\r\n| where Message startswith \"Executed 'Functions.QueueHandler'\"\r\n| summarize arg_max(TimeGenerated, Message) by InvocationId\r\n| project InvocationId, Completed=TimeGenerated,\r\n    Result=case(Message contains '(Succeeded,', 'Succeeded', Message contains '(Failed,', 'Failed', 'Not parsed');\r\nlet QueueAttempts = QueueInvocations\r\n| join kind=leftouter QueueTriggerDetails on InvocationId\r\n| join kind=leftouter QueueCompletions on InvocationId\r\n| extend Result=coalesce(Result,'Completion not observed'),\r\n    AgeAtDequeueSeconds = datetime_diff('second', Started, InsertedOn)\r\n| project Started, Queue, MessageId, DequeueCount, AgeAtDequeueSeconds, Result, Completed, InvocationId;\r\nlet Selection=base64_decode_tostring('{SelectedQueueMessage:base64}');\r\nlet QueueSelection=base64_decode_tostring('{QueueFilter:base64}');\r\nQueueAttempts\r\n| where isnotempty(Selection) and MessageId == Selection\r\n| where QueueSelection == 'all' or Queue == QueueSelection\r\n| order by Started asc | take 500",
              "title": "Selected message: observed processing attempts",
              "gridSettings": {
                "filter": true,
                "rowLimit": 15
              },
              "exportToExcelOptions": "all",
              "queryType": 0,
              "timeContextFromParameter": "TimeRange",
              "size": 3,
              "visualization": "table",
              "version": "KqlItem/1.0",
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "queue-message-detail",
            "conditionalVisibility": {
              "parameterName": "SelectedQueueMessage",
              "comparison": "isNotEqualTo",
              "value": ""
            }
          },
          {
            "content": {
