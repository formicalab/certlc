              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Started",
                    "formatter": 6,
                    "formatOptions": {
                      "customColumnWidthSetting": "20ch"
                    },
                    "dateFormat": {
                      "showUtcTime": null,
                      "formatName": "shortDateTimeNoMsPattern"
