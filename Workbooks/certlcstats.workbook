          {
            "content": {
              "parameters": [
                {
                  "value": "",
                  "id": "fc384b69-dd7e-4977-bfbe-706cc14297dc",
                  "name": "EventGridSearch",
                  "version": "KqlParameterItem/1.0",
                  "type": 1,
                  "label": "Search delivery failures"
                }
              ],
              "style": "formVertical",
              "version": "KqlParameterItem/1.0"
            },
            "type": 9,
            "name": "eventgrid-search"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportToExcelOptions": "all",
              "query": "// Failure columns may not exist until diagnostic logging produces its first record.\r\n// Use the selected topic's actual source, never a job ID or an Event Grid systemId.\r\nlet EventGridFailures = materialize(AzureDiagnostics\r\n| where TimeGenerated {TimeRange}\r\n| where Category == 'DeliveryFailures' and _ResourceId =~ '{EventGridTopic}'\r\n| extend Extra = column_ifexists('AdditionalFields', dynamic({}))\r\n| extend Raw = coalesce(tostring(column_ifexists('message_s', '')), tostring(column_ifexists('Message', '')), tostring(Extra.message)),\r\n    EventSubscription = coalesce(tostring(column_ifexists('eventSubscriptionName_s', '')), tostring(Extra.eventSubscriptionName))\r\n| extend CorrelationId = extract(@'(?:^|[,;]\\s*|Message:)id=([^,;\\s]+)', 1, Raw),\r\n    FailureOutcome = extract(@'(?:^|[,;]\\s*|Message:)outcome=([^,;]+)', 1, Raw),\r\n    DeliveryCount = tolong(extract(@'(?:^|[,;]\\s*)deliveryCount=(\\d+)', 1, Raw)),\r\n    LatencyMs = todouble(extract(@'(?:^|[,;]\\s*)latencyInMs=([\\d.]+)', 1, Raw)),\r\n    EventType = extract(@'(?:^|[,;]\\s*)eventType=([^,;\\s]+)', 1, Raw),\r\n    EventTime = todatetime(extract(@'(?:^|[,;]\\s*)eventTime=([^,;]+)', 1, Raw)),\r\n    EventSource = tolower('{EventGridSource}')\r\n// Unknown identities stay isolated and still offer their raw diagnostic record.\r\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId,\r\n    iff(isempty(CorrelationId), strcat('eventgrid:', hash_sha256(strcat(TimeGenerated, '|', EventSubscription, '|', Raw))), '')))\r\n| project TimeGenerated, EventKey, CorrelationId, EventSource, EventSubscription,\r\n    FailureOutcome = coalesce(FailureOutcome, 'Not parsed'), DeliveryCount, LatencyMs, EventType, EventTime, Raw);\r\n\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{EventGridSearch:base64}'));\r\nEventGridFailures\r\n| where isempty(SearchText) or CorrelationId contains SearchText or EventSubscription contains SearchText\r\n    or FailureOutcome contains SearchText or Raw contains SearchText\r\n| summarize FailureRecords=count(), IdentifiedEvents=dcountif(CorrelationId,isnotempty(CorrelationId)), LastObserved=max(TimeGenerated)\r\n    by EventSubscription,FailureOutcome\r\n| order by FailureRecords desc",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No delivery-failure records observed in the selected time range.",
              "title": "Delivery failures by outcome",
              "gridSettings": {
                "rowLimit": 500,
                "filter": true
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "eventgrid-failure-summary"
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportedParameters": [
                {
                  "parameterName": "SelectedFailureEvent",
                  "fieldName": "EventKey",
                  "parameterType": 1
                }
              ],
              "exportToExcelOptions": "all",
              "query": "// Failure columns may not exist until diagnostic logging produces its first record.\r\n// Use the selected topic's actual source, never a job ID or an Event Grid systemId.\r\nlet EventGridFailures = materialize(AzureDiagnostics\r\n| where TimeGenerated {TimeRange}\r\n| where Category == 'DeliveryFailures' and _ResourceId =~ '{EventGridTopic}'\r\n| extend Extra = column_ifexists('AdditionalFields', dynamic({}))\r\n| extend Raw = coalesce(tostring(column_ifexists('message_s', '')), tostring(column_ifexists('Message', '')), tostring(Extra.message)),\r\n    EventSubscription = coalesce(tostring(column_ifexists('eventSubscriptionName_s', '')), tostring(Extra.eventSubscriptionName))\r\n| extend CorrelationId = extract(@'(?:^|[,;]\\s*|Message:)id=([^,;\\s]+)', 1, Raw),\r\n    FailureOutcome = extract(@'(?:^|[,;]\\s*|Message:)outcome=([^,;]+)', 1, Raw),\r\n    DeliveryCount = tolong(extract(@'(?:^|[,;]\\s*)deliveryCount=(\\d+)', 1, Raw)),\r\n    LatencyMs = todouble(extract(@'(?:^|[,;]\\s*)latencyInMs=([\\d.]+)', 1, Raw)),\r\n    EventType = extract(@'(?:^|[,;]\\s*)eventType=([^,;\\s]+)', 1, Raw),\r\n    EventTime = todatetime(extract(@'(?:^|[,;]\\s*)eventTime=([^,;]+)', 1, Raw)),\r\n    EventSource = tolower('{EventGridSource}')\r\n// Unknown identities stay isolated and still offer their raw diagnostic record.\r\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId,\r\n    iff(isempty(CorrelationId), strcat('eventgrid:', hash_sha256(strcat(TimeGenerated, '|', EventSubscription, '|', Raw))), '')))\r\n| project TimeGenerated, EventKey, CorrelationId, EventSource, EventSubscription,\r\n    FailureOutcome = coalesce(FailureOutcome, 'Not parsed'), DeliveryCount, LatencyMs, EventType, EventTime, Raw);\r\nlet SearchText = trim(@'\\s+', base64_decode_tostring('{EventGridSearch:base64}'));\r\nEventGridFailures\r\n| where isempty(SearchText) or CorrelationId contains SearchText or EventSubscription contains SearchText\r\n    or FailureOutcome contains SearchText or Raw contains SearchText\r\n| project Time = TimeGenerated, EventSubscription, FailureOutcome, CorrelationId, DeliveryCount, LatencyMs, EventType, Raw, EventKey\r\n| order by Time desc\r\n| take 500",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No delivery-failure records observed in the selected workspace and time range.",
              "gridSettings": {
                "formatters": [
                  {
                    "formatter": 5,
                    "columnMatch": "EventKey"
                  }
                ],
                "filter": true,
                "rowLimit": 15
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "title": "Delivery failure records",
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ],
              "size": 3
            },
            "type": 3,
            "name": "eventgrid-failures"
          },
          {
            "content": {
              "showExportToExcel": true,
              "query": "// Failure columns may not exist until diagnostic logging produces its first record.\r\n// Use the selected topic's actual source, never a job ID or an Event Grid systemId.\r\nlet EventGridFailures = materialize(AzureDiagnostics\r\n| where TimeGenerated {TimeRange}\r\n| where Category == 'DeliveryFailures' and _ResourceId =~ '{EventGridTopic}'\r\n| extend Extra = column_ifexists('AdditionalFields', dynamic({}))\r\n| extend Raw = coalesce(tostring(column_ifexists('message_s', '')), tostring(column_ifexists('Message', '')), tostring(Extra.message)),\r\n    EventSubscription = coalesce(tostring(column_ifexists('eventSubscriptionName_s', '')), tostring(Extra.eventSubscriptionName))\r\n| extend CorrelationId = extract(@'(?:^|[,;]\\s*|Message:)id=([^,;\\s]+)', 1, Raw),\r\n    FailureOutcome = extract(@'(?:^|[,;]\\s*|Message:)outcome=([^,;]+)', 1, Raw),\r\n    DeliveryCount = tolong(extract(@'(?:^|[,;]\\s*)deliveryCount=(\\d+)', 1, Raw)),\r\n    LatencyMs = todouble(extract(@'(?:^|[,;]\\s*)latencyInMs=([\\d.]+)', 1, Raw)),\r\n    EventType = extract(@'(?:^|[,;]\\s*)eventType=([^,;\\s]+)', 1, Raw),\r\n    EventTime = todatetime(extract(@'(?:^|[,;]\\s*)eventTime=([^,;]+)', 1, Raw)),\r\n    EventSource = tolower('{EventGridSource}')\r\n// Unknown identities stay isolated and still offer their raw diagnostic record.\r\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId,\r\n    iff(isempty(CorrelationId), strcat('eventgrid:', hash_sha256(strcat(TimeGenerated, '|', EventSubscription, '|', Raw))), '')))\r\n| project TimeGenerated, EventKey, CorrelationId, EventSource, EventSubscription,\r\n    FailureOutcome = coalesce(FailureOutcome, 'Not parsed'), DeliveryCount, LatencyMs, EventType, EventTime, Raw);\r\nlet SelectedKey = base64_decode_tostring('{SelectedFailureEvent:base64}');\r\nEventGridFailures\r\n| where isnotempty(SelectedKey) and EventKey == SelectedKey\r\n| project Time = TimeGenerated, EventSubscription, FailureOutcome, CorrelationId, DeliveryCount, LatencyMs, EventType, Raw\r\n| order by Time asc\r\n| take 500",
              "title": "Selected event: delivery failure details",
              "gridSettings": {
                "rowLimit": 15,
                "filter": true
              },
              "exportToExcelOptions": "all",
              "queryType": 0,
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "version": "KqlItem/1.0",
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ],
              "size": 3
            },
            "type": 3,
            "name": "eventgrid-failure-details",
            "conditionalVisibility": {
              "parameterName": "SelectedFailureEvent",
              "comparison": "isNotEqualTo",
              "value": ""
            }
          },
          {
            "content": {
              "resourceType": "microsoft.operationalinsights/workspaces",
              "exportToExcelOptions": "all",
              "query": "// Receipt evidence comes from the Function, not an Event Grid success-log feed.\r\nlet ReceiptTraces=materialize(AppTraces\r\n| where TimeGenerated {TimeRange} and AppRoleName =~ '{FunctionApp:name}'\r\n| extend InvocationId=coalesce(tostring(Properties.InvocationId),OperationId)\r\n| where isnotempty(InvocationId));\r\nlet ReceiptIdentity=ReceiptTraces\r\n| where Message has 'BridgeCorrelation'\r\n| extend Entry=parse_json(extract(@'(\\{.*\\})',1,Message))\r\n| where tostring(Entry.recordType) == 'BridgeCorrelation' and tostring(Entry.stage) == 'Received'\r\n| where tostring(Entry.eventSource) =~ '{EventGridSource}'\r\n| summarize arg_min(TimeGenerated,*) by InvocationId\r\n| project Received=TimeGenerated,InvocationId,CorrelationId=tostring(Entry.correlationId);\r\nlet ReceiptPayload=ReceiptTraces\r\n| where Message contains 'CERTLC: full message received is:'\r\n| extend Payload=parse_json(extract(@'CERTLC: full message received is:\\s*(.*)$',1,Message))\r\n| where tostring(Payload.type) == 'Microsoft.KeyVault.CertificateNearExpiry'\r\n| summarize arg_min(TimeGenerated,*) by InvocationId\r\n| project InvocationId,Certificate=coalesce(tostring(Payload.data.ObjectName),tostring(Payload.subject)),\r\n    EventTime=todatetime(Payload['time']);\r\nlet SearchText=trim(@'\\s+',base64_decode_tostring('{EventGridSearch:base64}'));\r\nReceiptIdentity\r\n| join kind=inner ReceiptPayload on InvocationId\r\n| where isempty(SearchText) or Certificate contains SearchText or CorrelationId contains SearchText or InvocationId contains SearchText\r\n| project Received,Certificate,EventTime,CorrelationId,InvocationId\r\n| order by Received desc | take 500",
              "version": "KqlItem/1.0",
              "showExportToExcel": true,
              "queryType": 0,
              "noDataMessage": "No matching near-expiry receipt records observed at the selected Function.",
              "title": "Near-expiry events observed at Function (receipt evidence)",
              "gridSettings": {
                "filter": true,
                "rowLimit": 15
              },
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "size": 3,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ]
            },
            "type": 3,
            "name": "eventgrid-observed-receipts"
          },
          {
            "content": {
              "chartId": "certlc-preview-eventgrid-published",
