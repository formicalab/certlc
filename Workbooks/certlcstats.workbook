            "content": {
              "query": "// Host trigger records expose actual dequeue count and insertion time; storage calls do not.\r\nlet QueueTraces = materialize(AppTraces\r\n| where TimeGenerated {TimeRange} and AppRoleName =~ '{FunctionApp:name}'\r\n| extend InvocationId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\r\n| where isnotempty(InvocationId));\r\nlet QueueInvocations = QueueTraces\r\n| where Message startswith \"Executing 'Functions.QueueHandler'\" and Message contains 'New queue message detected'\r\n| extend Queue = extract(@\"New queue message detected on '([^']+)'\", 1, Message)\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| summarize Started=min(TimeGenerated) by InvocationId, Queue;\r\nlet QueueTriggerDetails = QueueTraces\r\n| where Message startswith 'Trigger Details:'\r\n| extend MessageId=extract(@'MessageId:\\s*([^,\\s]+)',1,Message),\r\n    DequeueCount=toint(extract(@'DequeueCount:\\s*(\\d+)',1,Message)),\r\n    InsertedOn=todatetime(extract(@'InsertedOn:\\s*([^,\\s]+)',1,Message))\r\n| summarize arg_min(TimeGenerated, *) by InvocationId\r\n| project InvocationId, MessageId, DequeueCount, InsertedOn;\r\nlet QueueCompletions = QueueTraces\r\n| where Message startswith \"Executed 'Functions.QueueHandler'\"\r\n| summarize arg_max(TimeGenerated, Message) by InvocationId\r\n| project InvocationId, Completed=TimeGenerated,\r\n    Result=case(Message contains '(Succeeded,', 'Succeeded', Message contains '(Failed,', 'Failed', 'Not parsed');\r\nlet QueueAttempts = QueueInvocations\r\n| join kind=leftouter QueueTriggerDetails on InvocationId\r\n| join kind=leftouter QueueCompletions on InvocationId\r\n| extend Result=coalesce(Result,'Completion not observed'),\r\n    AgeAtDequeueSeconds = datetime_diff('second', Started, InsertedOn)\r\n| project Started, Queue, MessageId, InsertedOn, DequeueCount, AgeAtDequeueSeconds, Result, Completed, InvocationId;\r\nlet JourneyQueueEvidence=QueueAttempts\r\n| order by Queue asc, MessageId asc, Started asc, InvocationId asc\r\n| serialize\r\n| extend RetryGapSeconds=iff(isnotempty(MessageId) and Queue == prev(Queue) and MessageId == prev(MessageId),\r\n    datetime_diff('millisecond',Started,prev(Started))/1000.0, real(null))\r\n| project AttemptId=InvocationId, Queue, QueueMessageId=MessageId, Dequeued=Started, InsertedOn, DequeueCount,\r\n    AgeAtDequeueSeconds, RetryGapSeconds, QueueResult=Result, QueueCompleted=Completed,\r\n    FunctionDurationSeconds=datetime_diff('millisecond',Completed,Started)/1000.0;\n// Scope every scan to the selected time and existing resources.\n// Reuse certlcstats resource selectors instead of pinning Journey to one deployment.\n// Match Job History: nested resource names may include the Automation account prefix.\nlet SelectedRunbookName = tostring(split('{Runbook:name}', '/')[-1]);\nlet Traces = materialize(AppTraces\n| where TimeGenerated {TimeRange}\n| where AppRoleName =~ '{FunctionApp:name}'\n| extend AttemptId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\n| where isnotempty(AttemptId));\nlet Bridge = Traces\n| where Message has 'BridgeCorrelation'\n| extend Entry = parse_json(extract(@'(\\{.*\\})', 1, Message))\n| where tostring(Entry.recordType) == 'BridgeCorrelation';\n// Only receipt records establish event identity. Older Started records used job fallback.\nlet Receipts = Bridge\n| where tostring(Entry.stage) == 'Received'\n| summarize arg_min(TimeGenerated, *) by AttemptId\n| project AttemptId, OperationId, Received = TimeGenerated,\n    CorrelationId = tostring(Entry.correlationId), EventSource = iff(tostring(Entry.eventSource) startswith '/subscriptions/', tolower(tostring(Entry.eventSource)), tostring(Entry.eventSource));\n// Keep each invocation/job association: repeated delivery must not erase earlier attempts.\nlet Links = Bridge\n| where tostring(Entry.stage) == 'Started' and isnotempty(tostring(Entry.jobId))\n| summarize Submitted = min(TimeGenerated) by AttemptId, JobId = tolower(tostring(Entry.jobId));\nlet Payloads = Traces\n| where Message contains 'CERTLC: full message received is:'\n| extend Payload = parse_json(extract(@'CERTLC: full message received is:\\s*(.*)$', 1, Message))\n| summarize arg_min(TimeGenerated, *) by AttemptId\n// Bracket notation preserves the CloudEvent field whose name is a KQL keyword.\n| project AttemptId, Certificate = coalesce(tostring(Payload.data.ObjectName), tostring(Payload.subject)),\n    EventType = tostring(Payload.type), EventTime = todatetime(Payload['time']);\nlet Streams = materialize(AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where Category == 'JobStreams' and Resource =~ '{AutomationAccount:name}' and RunbookName_s =~ SelectedRunbookName\n| extend JobId = tolower(tostring(JobId_g)), Raw = replace_regex(tostring(ResultDescription), @'\\x1B\\[[0-9;]*[A-Za-z]', '')\n| extend Entry = parse_json(extract(@'(\\{.*\\})', 1, Raw))\n| extend Message = coalesce(tostring(Entry.message), Raw), Section = coalesce(tostring(Entry.section), StreamType_s),\n    Level = coalesce(tostring(Entry.level), StreamType_s), LogTime = coalesce(todatetime(Entry.timestamp), TimeGenerated));\nlet Jobs = AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where Category == 'JobLogs' and Resource =~ '{AutomationAccount:name}' and RunbookName_s =~ SelectedRunbookName\n| summarize arg_max(TimeGenerated, ResultType) by JobId = tolower(tostring(JobId_g))\n| project JobId, JobStatus = ResultType, StatusObserved = TimeGenerated;\n// Operation outcome is not the same as Automation completion or SMTP delivery.\nlet Outcomes = Streams\n| summarize Warnings = countif(Level =~ 'Warning'), Errors = countif(Level =~ 'Error'),\n    Succeeded = countif(Section startswith 'Dispatcher.' and Message contains 'successfully'),\n    // Missing SMTP is not a skipped certificate operation.\n    Skipped = countif(Section == 'Dispatcher.Renewal' and Message startswith 'Skipping auto-renewal of certificate'),\n    EmailSent = countif(Section == 'Send-NotificationEmail' and Message startswith 'Notification email sent'),\n    EmailFailed = countif(Section == 'Send-NotificationEmail' and Level =~ 'Warning') by JobId;\nlet Exceptions = AppExceptions\n| where TimeGenerated {TimeRange}\n| where AppRoleName =~ '{FunctionApp:name}'\n| extend AttemptId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\n| summarize FunctionErrors = count() by AttemptId;\nlet BridgeAttempts = Receipts\n| join kind=leftouter JourneyQueueEvidence on AttemptId\n| join kind=leftouter Links on AttemptId\n| join kind=leftouter Payloads on AttemptId\n| join kind=leftouter Jobs on JobId\n| join kind=leftouter Outcomes on JobId\n| join kind=leftouter Exceptions on AttemptId\n// JSON tuple prevents ambiguous concatenation; unidentified receipts remain separate.\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId, iff(isempty(CorrelationId), AttemptId, ''))),\n    JobStatus = coalesce(JobStatus, 'Not observed'),\n    OperationOutcome = case(Errors > 0, 'Error logged', Skipped > 0, 'Skipped', Succeeded > 0, 'Success logged', 'Not observed'),\n    Notification = case(EmailFailed > 0, 'Delivery warning', EmailSent > 0, 'Sent', 'Not observed'),\n    Warnings = coalesce(Warnings, 0), Errors = coalesce(Errors, 0), FunctionErrors = coalesce(FunctionErrors, 0);\n\n// Failure columns may not exist until diagnostic logging produces its first record.\n// Use the selected topic's actual source, never a job ID or an Event Grid systemId.\nlet EventGridFailures = materialize(AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where Category == 'DeliveryFailures' and _ResourceId =~ '{EventGridTopic}'\n| extend Extra = column_ifexists('AdditionalFields', dynamic({}))\n| extend Raw = coalesce(tostring(column_ifexists('message_s', '')), tostring(column_ifexists('Message', '')), tostring(Extra.message)),\n    EventSubscription = coalesce(tostring(column_ifexists('eventSubscriptionName_s', '')), tostring(Extra.eventSubscriptionName))\n| extend CorrelationId = extract(@'(?:^|[,;]\\s*|Message:)id=([^,;\\s]+)', 1, Raw),\n    FailureOutcome = extract(@'(?:^|[,;]\\s*|Message:)outcome=([^,;]+)', 1, Raw),\n    DeliveryCount = tolong(extract(@'(?:^|[,;]\\s*)deliveryCount=(\\d+)', 1, Raw)),\n    LatencyMs = todouble(extract(@'(?:^|[,;]\\s*)latencyInMs=([\\d.]+)', 1, Raw)),\n    EventType = extract(@'(?:^|[,;]\\s*)eventType=([^,;\\s]+)', 1, Raw),\n    EventTime = todatetime(extract(@'(?:^|[,;]\\s*)eventTime=([^,;]+)', 1, Raw)),\n    EventSource = tolower('{EventGridSource}')\n// Unknown identities stay isolated and still offer their raw diagnostic record.\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId,\n    iff(isempty(CorrelationId), strcat('eventgrid:', hash_sha256(strcat(TimeGenerated, '|', EventSubscription, '|', Raw))), '')))\n| project TimeGenerated, EventKey, CorrelationId, EventSource, EventSubscription,\n    FailureOutcome = coalesce(FailureOutcome, 'Not parsed'), DeliveryCount, LatencyMs, EventType, EventTime, Raw);\nlet FailureSummary = EventGridFailures\n| summarize FirstFailure = min(TimeGenerated), LastFailure = max(TimeGenerated),\n    EventGridFailureCount = count(), FailureEventTypes = make_set(EventType), FailureEventTime = min(EventTime)\n    by EventKey, CorrelationId, EventSource;\n// A failed delivery is an observation, not a Function invocation or an Automation outcome.\nlet Attempts = union\n    (BridgeAttempts\n    | join kind=leftouter FailureSummary on EventKey\n    | extend FirstObserved = min_of(Received, FirstFailure),\n        StatusObserved = max_of(StatusObserved, Received, LastFailure),\n        EventGridFailureCount = coalesce(EventGridFailureCount, 0)),\n    (FailureSummary\n    | join kind=leftanti (BridgeAttempts | distinct EventKey) on EventKey\n    | project EventKey, CorrelationId, EventSource,\n        FirstObserved = FirstFailure, Received = datetime(null), StatusObserved = LastFailure,\n        AttemptId = '', OperationId = '', JobId = '', Certificate = '',\n        EventType = tostring(FailureEventTypes[0]), EventTime = FailureEventTime,\n        JobStatus = 'Not observed', OperationOutcome = 'Not observed', Notification = 'Not observed',\n        Warnings = tolong(0), Errors = tolong(0), FunctionErrors = tolong(0), EventGridFailureCount);\nlet JourneyQueueObservations = materialize(Attempts\r\n| where isnotempty(AttemptId) and isnotempty(QueueMessageId)\r\n| distinct EventKey, AttemptId, Queue, QueueMessageId, Dequeued, InsertedOn, DequeueCount,\r\n    AgeAtDequeueSeconds, RetryGapSeconds, QueueResult, QueueCompleted, FunctionDurationSeconds);\r\nlet JourneyMessages = JourneyQueueObservations\r\n| summarize arg_max(Dequeued, QueueResult), ObservedDequeues=count(), HighestDequeueCount=max(DequeueCount),\r\n    FailedDequeues=countif(QueueResult == 'Failed'), RetryObservations=countif(DequeueCount > 1)\r\n    by EventKey, Queue, QueueMessageId;\r\nlet JourneyQueueSummary = JourneyMessages\r\n| summarize QueueMessages=count(), ObservedDequeues=sum(ObservedDequeues), HighestDequeueCount=max(HighestDequeueCount),\r\n    FailedDequeues=sum(FailedDequeues), RetryObservations=sum(RetryObservations),\r\n    LatestSucceeded=countif(QueueResult == 'Succeeded'), LatestFailed=countif(QueueResult == 'Failed'),\r\n    LatestUnobserved=countif(QueueResult !in ('Succeeded','Failed')) by EventKey\r\n| extend QueueStatus=case(LatestFailed > 0, 'Latest processing failed', LatestUnobserved > 0, 'Completion not observed',\r\n    LatestSucceeded > 0, 'Latest processing succeeded', 'Not observed');\nlet SelectedKey=base64_decode_tostring('{SelectedEvent:base64}');\r\nAttempts\r\n| where isnotempty(SelectedKey) and EventKey == SelectedKey\r\n| summarize Certificates=make_set_if(Certificate,isnotempty(Certificate)), EventTypes=make_set_if(EventType,isnotempty(EventType)),\r\n    FailureRecords=max(EventGridFailureCount) by EventKey,CorrelationId,EventSource\r\n| join kind=leftouter JourneyQueueSummary on EventKey\r\n| project Details=pack_array(\r\n    pack('Field','Certificate','Value',strcat_array(Certificates,', ')),\r\n    pack('Field','Event type','Value',strcat_array(EventTypes,', ')),\r\n    pack('Field','Correlation ID','Value',CorrelationId),\r\n    pack('Field','Source','Value',EventSource),\r\n    pack('Field','Event Grid failure records','Value',tostring(FailureRecords)),\r\n    pack('Field','Queue messages / observed dequeues','Value',strcat(coalesce(QueueMessages,0),' / ',coalesce(ObservedDequeues,0))),\r\n    pack('Field','Highest observed dequeue count','Value',tostring(HighestDequeueCount)),\r\n    pack('Field','Retry / failed processing observations','Value',strcat(coalesce(RetryObservations,0),' / ',coalesce(FailedDequeues,0))),\r\n    pack('Field','Latest processing per message','Value',coalesce(QueueStatus,'Not observed')))\r\n| mv-expand Details\r\n| project Field=tostring(Details.Field),Value=coalesce(tostring(Details.Value),'Not observed')",
              "visualization": "table",
              "gridSettings": {
                "rowLimit": 12,
                "formatters": [
                  {
                    "formatOptions": {
                      "customColumnWidthSetting": "38ch"
                    },
                    "columnMatch": "Field",
                    "formatter": 1
                  },
                  {
                    "formatOptions": {
                      "customColumnWidthSetting": "1fr"
                    },
                    "columnMatch": "Value",
                    "formatter": 1
                  }
                ]
              },
              "version": "KqlItem/1.0",
              "resourceType": "microsoft.operationalinsights/workspaces",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ],
              "title": "Selected event"
            },
            "type": 3
          },
          {
            "name": "event-timeline",
            "conditionalVisibility": {
              "comparison": "isNotEqualTo",
              "value": "",
              "parameterName": "SelectedEvent"
            },
            "content": {
              "query": "// Host trigger records expose actual dequeue count and insertion time; storage calls do not.\r\nlet QueueTraces = materialize(AppTraces\r\n| where TimeGenerated {TimeRange} and AppRoleName =~ '{FunctionApp:name}'\r\n| extend InvocationId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\r\n| where isnotempty(InvocationId));\r\nlet QueueInvocations = QueueTraces\r\n| where Message startswith \"Executing 'Functions.QueueHandler'\" and Message contains 'New queue message detected'\r\n| extend Queue = extract(@\"New queue message detected on '([^']+)'\", 1, Message)\r\n| where Queue in ('certlc', 'certlc-poison')\r\n| summarize Started=min(TimeGenerated) by InvocationId, Queue;\r\nlet QueueTriggerDetails = QueueTraces\r\n| where Message startswith 'Trigger Details:'\r\n| extend MessageId=extract(@'MessageId:\\s*([^,\\s]+)',1,Message),\r\n    DequeueCount=toint(extract(@'DequeueCount:\\s*(\\d+)',1,Message)),\r\n    InsertedOn=todatetime(extract(@'InsertedOn:\\s*([^,\\s]+)',1,Message))\r\n| summarize arg_min(TimeGenerated, *) by InvocationId\r\n| project InvocationId, MessageId, DequeueCount, InsertedOn;\r\nlet QueueCompletions = QueueTraces\r\n| where Message startswith \"Executed 'Functions.QueueHandler'\"\r\n| summarize arg_max(TimeGenerated, Message) by InvocationId\r\n| project InvocationId, Completed=TimeGenerated,\r\n    Result=case(Message contains '(Succeeded,', 'Succeeded', Message contains '(Failed,', 'Failed', 'Not parsed');\r\nlet QueueAttempts = QueueInvocations\r\n| join kind=leftouter QueueTriggerDetails on InvocationId\r\n| join kind=leftouter QueueCompletions on InvocationId\r\n| extend Result=coalesce(Result,'Completion not observed'),\r\n    AgeAtDequeueSeconds = datetime_diff('second', Started, InsertedOn)\r\n| project Started, Queue, MessageId, InsertedOn, DequeueCount, AgeAtDequeueSeconds, Result, Completed, InvocationId;\r\nlet JourneyQueueEvidence=QueueAttempts\r\n| order by Queue asc, MessageId asc, Started asc, InvocationId asc\r\n| serialize\r\n| extend RetryGapSeconds=iff(isnotempty(MessageId) and Queue == prev(Queue) and MessageId == prev(MessageId),\r\n    datetime_diff('millisecond',Started,prev(Started))/1000.0, real(null))\r\n| project AttemptId=InvocationId, Queue, QueueMessageId=MessageId, Dequeued=Started, InsertedOn, DequeueCount,\r\n    AgeAtDequeueSeconds, RetryGapSeconds, QueueResult=Result, QueueCompleted=Completed,\r\n    FunctionDurationSeconds=datetime_diff('millisecond',Completed,Started)/1000.0;\n// Scope every scan to the selected time and existing resources.\n// Reuse certlcstats resource selectors instead of pinning Journey to one deployment.\n// Match Job History: nested resource names may include the Automation account prefix.\nlet SelectedRunbookName = tostring(split('{Runbook:name}', '/')[-1]);\nlet Traces = materialize(AppTraces\n| where TimeGenerated {TimeRange}\n| where AppRoleName =~ '{FunctionApp:name}'\n| extend AttemptId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\n| where isnotempty(AttemptId));\nlet Bridge = Traces\n| where Message has 'BridgeCorrelation'\n| extend Entry = parse_json(extract(@'(\\{.*\\})', 1, Message))\n| where tostring(Entry.recordType) == 'BridgeCorrelation';\n// Only receipt records establish event identity. Older Started records used job fallback.\nlet Receipts = Bridge\n| where tostring(Entry.stage) == 'Received'\n| summarize arg_min(TimeGenerated, *) by AttemptId\n| project AttemptId, OperationId, Received = TimeGenerated,\n    CorrelationId = tostring(Entry.correlationId), EventSource = iff(tostring(Entry.eventSource) startswith '/subscriptions/', tolower(tostring(Entry.eventSource)), tostring(Entry.eventSource));\n// Keep each invocation/job association: repeated delivery must not erase earlier attempts.\nlet Links = Bridge\n| where tostring(Entry.stage) == 'Started' and isnotempty(tostring(Entry.jobId))\n| summarize Submitted = min(TimeGenerated) by AttemptId, JobId = tolower(tostring(Entry.jobId));\nlet Payloads = Traces\n| where Message contains 'CERTLC: full message received is:'\n| extend Payload = parse_json(extract(@'CERTLC: full message received is:\\s*(.*)$', 1, Message))\n| summarize arg_min(TimeGenerated, *) by AttemptId\n// Bracket notation preserves the CloudEvent field whose name is a KQL keyword.\n| project AttemptId, Certificate = coalesce(tostring(Payload.data.ObjectName), tostring(Payload.subject)),\n    EventType = tostring(Payload.type), EventTime = todatetime(Payload['time']);\nlet Streams = materialize(AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where Category == 'JobStreams' and Resource =~ '{AutomationAccount:name}' and RunbookName_s =~ SelectedRunbookName\n| extend JobId = tolower(tostring(JobId_g)), Raw = replace_regex(tostring(ResultDescription), @'\\x1B\\[[0-9;]*[A-Za-z]', '')\n| extend Entry = parse_json(extract(@'(\\{.*\\})', 1, Raw))\n| extend Message = coalesce(tostring(Entry.message), Raw), Section = coalesce(tostring(Entry.section), StreamType_s),\n    Level = coalesce(tostring(Entry.level), StreamType_s), LogTime = coalesce(todatetime(Entry.timestamp), TimeGenerated));\nlet Jobs = AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where Category == 'JobLogs' and Resource =~ '{AutomationAccount:name}' and RunbookName_s =~ SelectedRunbookName\n| summarize arg_max(TimeGenerated, ResultType) by JobId = tolower(tostring(JobId_g))\n| project JobId, JobStatus = ResultType, StatusObserved = TimeGenerated;\n// Operation outcome is not the same as Automation completion or SMTP delivery.\nlet Outcomes = Streams\n| summarize Warnings = countif(Level =~ 'Warning'), Errors = countif(Level =~ 'Error'),\n    Succeeded = countif(Section startswith 'Dispatcher.' and Message contains 'successfully'),\n    // Missing SMTP is not a skipped certificate operation.\n    Skipped = countif(Section == 'Dispatcher.Renewal' and Message startswith 'Skipping auto-renewal of certificate'),\n    EmailSent = countif(Section == 'Send-NotificationEmail' and Message startswith 'Notification email sent'),\n    EmailFailed = countif(Section == 'Send-NotificationEmail' and Level =~ 'Warning') by JobId;\nlet Exceptions = AppExceptions\n| where TimeGenerated {TimeRange}\n| where AppRoleName =~ '{FunctionApp:name}'\n| extend AttemptId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\n| summarize FunctionErrors = count() by AttemptId;\nlet BridgeAttempts = Receipts\n| join kind=leftouter JourneyQueueEvidence on AttemptId\n| join kind=leftouter Links on AttemptId\n| join kind=leftouter Payloads on AttemptId\n| join kind=leftouter Jobs on JobId\n| join kind=leftouter Outcomes on JobId\n| join kind=leftouter Exceptions on AttemptId\n// JSON tuple prevents ambiguous concatenation; unidentified receipts remain separate.\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId, iff(isempty(CorrelationId), AttemptId, ''))),\n    JobStatus = coalesce(JobStatus, 'Not observed'),\n    OperationOutcome = case(Errors > 0, 'Error logged', Skipped > 0, 'Skipped', Succeeded > 0, 'Success logged', 'Not observed'),\n    Notification = case(EmailFailed > 0, 'Delivery warning', EmailSent > 0, 'Sent', 'Not observed'),\n    Warnings = coalesce(Warnings, 0), Errors = coalesce(Errors, 0), FunctionErrors = coalesce(FunctionErrors, 0);\n\n// Failure columns may not exist until diagnostic logging produces its first record.\n// Use the selected topic's actual source, never a job ID or an Event Grid systemId.\nlet EventGridFailures = materialize(AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where Category == 'DeliveryFailures' and _ResourceId =~ '{EventGridTopic}'\n| extend Extra = column_ifexists('AdditionalFields', dynamic({}))\n| extend Raw = coalesce(tostring(column_ifexists('message_s', '')), tostring(column_ifexists('Message', '')), tostring(Extra.message)),\n    EventSubscription = coalesce(tostring(column_ifexists('eventSubscriptionName_s', '')), tostring(Extra.eventSubscriptionName))\n| extend CorrelationId = extract(@'(?:^|[,;]\\s*|Message:)id=([^,;\\s]+)', 1, Raw),\n    FailureOutcome = extract(@'(?:^|[,;]\\s*|Message:)outcome=([^,;]+)', 1, Raw),\n    DeliveryCount = tolong(extract(@'(?:^|[,;]\\s*)deliveryCount=(\\d+)', 1, Raw)),\n    LatencyMs = todouble(extract(@'(?:^|[,;]\\s*)latencyInMs=([\\d.]+)', 1, Raw)),\n    EventType = extract(@'(?:^|[,;]\\s*)eventType=([^,;\\s]+)', 1, Raw),\n    EventTime = todatetime(extract(@'(?:^|[,;]\\s*)eventTime=([^,;]+)', 1, Raw)),\n    EventSource = tolower('{EventGridSource}')\n// Unknown identities stay isolated and still offer their raw diagnostic record.\n| extend EventKey = tostring(pack_array(EventSource, CorrelationId,\n    iff(isempty(CorrelationId), strcat('eventgrid:', hash_sha256(strcat(TimeGenerated, '|', EventSubscription, '|', Raw))), '')))\n| project TimeGenerated, EventKey, CorrelationId, EventSource, EventSubscription,\n    FailureOutcome = coalesce(FailureOutcome, 'Not parsed'), DeliveryCount, LatencyMs, EventType, EventTime, Raw);\nlet FailureSummary = EventGridFailures\n| summarize FirstFailure = min(TimeGenerated), LastFailure = max(TimeGenerated),\n    EventGridFailureCount = count(), FailureEventTypes = make_set(EventType), FailureEventTime = min(EventTime)\n    by EventKey, CorrelationId, EventSource;\n// A failed delivery is an observation, not a Function invocation or an Automation outcome.\nlet Attempts = union\n    (BridgeAttempts\n    | join kind=leftouter FailureSummary on EventKey\n    | extend FirstObserved = min_of(Received, FirstFailure),\n        StatusObserved = max_of(StatusObserved, Received, LastFailure),\n        EventGridFailureCount = coalesce(EventGridFailureCount, 0)),\n    (FailureSummary\n    | join kind=leftanti (BridgeAttempts | distinct EventKey) on EventKey\n    | project EventKey, CorrelationId, EventSource,\n        FirstObserved = FirstFailure, Received = datetime(null), StatusObserved = LastFailure,\n        AttemptId = '', OperationId = '', JobId = '', Certificate = '',\n        EventType = tostring(FailureEventTypes[0]), EventTime = FailureEventTime,\n        JobStatus = 'Not observed', OperationOutcome = 'Not observed', Notification = 'Not observed',\n        Warnings = tolong(0), Errors = tolong(0), FunctionErrors = tolong(0), EventGridFailureCount);\n// Selection is an encoded source/id tuple, so equal IDs from different producers stay separate.\nlet JourneyQueueObservations = materialize(Attempts\r\n| where isnotempty(AttemptId) and isnotempty(QueueMessageId)\r\n| distinct EventKey, AttemptId, Queue, QueueMessageId, Dequeued, InsertedOn, DequeueCount,\r\n    AgeAtDequeueSeconds, RetryGapSeconds, QueueResult, QueueCompleted, FunctionDurationSeconds);\r\nlet JourneyMessages = JourneyQueueObservations\r\n| summarize arg_max(Dequeued, QueueResult), ObservedDequeues=count(), HighestDequeueCount=max(DequeueCount),\r\n    FailedDequeues=countif(QueueResult == 'Failed'), RetryObservations=countif(DequeueCount > 1)\r\n    by EventKey, Queue, QueueMessageId;\r\nlet JourneyQueueSummary = JourneyMessages\r\n| summarize QueueMessages=count(), ObservedDequeues=sum(ObservedDequeues), HighestDequeueCount=max(HighestDequeueCount),\r\n    FailedDequeues=sum(FailedDequeues), RetryObservations=sum(RetryObservations),\r\n    LatestSucceeded=countif(QueueResult == 'Succeeded'), LatestFailed=countif(QueueResult == 'Failed'),\r\n    LatestUnobserved=countif(QueueResult !in ('Succeeded','Failed')) by EventKey\r\n| extend QueueStatus=case(LatestFailed > 0, 'Latest processing failed', LatestUnobserved > 0, 'Completion not observed',\r\n    LatestSucceeded > 0, 'Latest processing succeeded', 'Not observed');\nlet SelectedKey = base64_decode_tostring('{SelectedEvent:base64}');\nlet Selected = materialize(Attempts | where isnotempty(SelectedKey) and EventKey == SelectedKey);\n// One parent per invocation, even if several job associations are observed for that invocation.\nlet SelectedInvocations = materialize(Selected | where isnotempty(AttemptId)\n| summarize Received=min(Received), FunctionErrors=max(FunctionErrors), Queue=take_any(Queue), QueueMessageId=take_any(QueueMessageId),\r\n    Dequeued=min(Dequeued), InsertedOn=min(InsertedOn), DequeueCount=max(DequeueCount), AgeAtDequeueSeconds=max(AgeAtDequeueSeconds),\r\n    RetryGapSeconds=max(RetryGapSeconds), QueueResult=take_any(QueueResult), QueueCompleted=max(QueueCompleted),\r\n    FunctionDurationSeconds=max(FunctionDurationSeconds) by AttemptId,OperationId\n| order by Received asc, AttemptId asc\n| serialize AttemptNumber = row_number());\nlet SelectedJobs = materialize(Selected | where isnotempty(JobId)\n| distinct AttemptId, JobId, Submitted, JobStatus, OperationOutcome, Notification);\n// Explicit parents mirror the native Id/ParentId tree used by the production Job History.\nlet SelectedFailures = materialize(EventGridFailures\n| where isnotempty(SelectedKey) and EventKey == SelectedKey);\nlet SelectedQueueMessages=materialize(SelectedInvocations\r\n| where isnotempty(QueueMessageId)\r\n| summarize InsertedOn=min(InsertedOn), FirstDequeue=min(Dequeued), ObservedDequeues=count(),\r\n    HighestDequeueCount=max(DequeueCount), FailedDequeues=countif(QueueResult == 'Failed'), arg_max(Dequeued,QueueResult)\r\n    by Queue,QueueMessageId\r\n| extend MessageNode=strcat('queue:',hash_sha256(tostring(pack_array(Queue,QueueMessageId)))));\r\nlet Parents = union\r\n    (SelectedQueueMessages\r\n        | project Id=MessageNode, ParentId='event', Name=strcat('Queue message / ',Queue), Time=coalesce(InsertedOn,FirstDequeue),\r\n            Component='Queue', Stage='Message', FinalResult=case(QueueResult == 'Failed','failed',QueueResult == 'Succeeded','success','info'),\r\n            Message=strcat('Message ID: ',QueueMessageId,'\\nHost-observed dequeues: ',ObservedDequeues,\r\n                '; highest dequeue count: ',HighestDequeueCount,'; failed attempts: ',FailedDequeues,\r\n                '\\nLatest observed processing: ',QueueResult,'\\nInsertion time is reported by the Function host. Deletion and poison movement are not established.'),\r\n            AttemptId='', JobId=''),\n    (SelectedFailures | summarize Time = min(TimeGenerated), FailureRecords = count()\n        | where FailureRecords > 0\n        | project Id = 'eventgrid', ParentId = 'event', Name = 'Event Grid delivery',\n            Time, Component = 'EventGrid', Stage = 'Delivery attempts', FinalResult = 'warning',\n            Message = strcat('Observed delivery-failure records: ', FailureRecords), AttemptId = '', JobId = ''),\n    // Keep identity in the context view; parent details retain source, notifications and diagnostics.\n    (Selected | summarize Time = min(FirstObserved), Notifications = make_set(Notification), Warnings = sum(Warnings), Errors = sum(Errors), FunctionErrors = sum(FunctionErrors) by CorrelationId, EventSource\n        | project Id = 'event', ParentId = '', Name = 'Event',\n            Time, Component = 'Event', Stage = 'Correlation', FinalResult = 'info',\n            Message = strcat('Source: ', EventSource, '\\nNotifications: ', strcat_array(Notifications, ', '), '\\nWarnings: ', Warnings, '; Runbook errors: ', Errors, '; Function errors: ', FunctionErrors), AttemptId = '', JobId = ''),\n    (SelectedInvocations\n        | project Id = strcat('attempt:', AttemptId),\r\n            ParentId=iff(isnotempty(QueueMessageId),strcat('queue:',hash_sha256(tostring(pack_array(Queue,QueueMessageId)))),'event'),\r\n            Name=iff(isnotnull(DequeueCount),strcat('Dequeue ',DequeueCount),strcat('Attempt ',AttemptNumber)),\n            Time = coalesce(Dequeued,Received), Component = 'Attempt', Stage = 'Receipt', FinalResult = case(QueueResult == 'Failed' or FunctionErrors > 0,'failed',QueueResult == 'Succeeded','success','info'),\n            Message = strcat('Function invocation: ',AttemptId,'\\nHost completion: ',coalesce(QueueResult,'Not observed')), AttemptId, JobId = ''),\n    (SelectedInvocations\n        | project Id = strcat('function:', AttemptId), ParentId = strcat('attempt:', AttemptId), Name = 'Function activity',\n            Time = Received, Component = 'Function', Stage = 'Invocation', FinalResult = iff(FunctionErrors > 0, 'failed', 'info'),\n            Message = strcat('Operation ID: ', OperationId), AttemptId, JobId = ''),\n    (SelectedJobs\n        // Show the full job ID once in parent details instead of repeating it across every leaf.\n        | project Id = strcat('job:', AttemptId, ':', JobId), ParentId = strcat('attempt:', AttemptId), Name = 'Automation job',\n            Time = Submitted, Component = 'Automation', Stage = 'Job',\n            FinalResult = case(JobStatus =~ 'Failed', 'failed', JobStatus in~ ('Stopped', 'Suspended'), 'warning', JobStatus =~ 'Completed', 'success', 'info'),\n            Message = strcat('Job ID: ', JobId, '\\nState: ', JobStatus, '; Operation: ', OperationOutcome, '; Notification: ', Notification), AttemptId, JobId);\n// Cap only leaf records. Parents remain present even when the detail stream is truncated.\nlet Records = union\r\n    (SelectedQueueMessages | where isnotnull(InsertedOn)\r\n        | project ParentId=MessageNode,Time=InsertedOn,Component='Queue',Stage='Insertion timestamp (host-reported)',Level='Information',\r\n            Message=strcat('Queue: ',Queue,'; Message ID: ',QueueMessageId),AttemptId='',JobId=''),\r\n    (SelectedInvocations | where isnotnull(Dequeued)\r\n        | project ParentId=strcat('attempt:',AttemptId),Time=Dequeued,Component='Queue',Stage='Dequeue observed by Function host',\r\n            Level=iff(DequeueCount > 1,'Warning','Information'),\r\n            Message=strcat('Message ID: ',QueueMessageId,'\\nDequeue count: ',DequeueCount,\r\n                '; age at dequeue (seconds, includes retries): ',coalesce(tostring(AgeAtDequeueSeconds),'Not observed'),\r\n                '\\nGap since previous observed dequeue (seconds): ',coalesce(tostring(RetryGapSeconds),'Not observed')),\r\n            AttemptId,JobId=''),\r\n    (SelectedInvocations | where isnotnull(QueueCompleted)\r\n        | project ParentId=strcat('function:',AttemptId),Time=QueueCompleted,Component='Function',Stage='Host completion',\r\n            Level=iff(QueueResult == 'Failed','Error','Information'),\r\n            Message=strcat('Result: ',QueueResult,'; Function duration (seconds): ',FunctionDurationSeconds,\r\n                '\\nFunction completion does not establish runbook success or queue deletion.'),AttemptId,JobId=''),\r\n    (Selected | where isnotempty(JobId) and isnotnull(Submitted)\r\n        | distinct AttemptId,JobId,Submitted,Dequeued\r\n        | project ParentId=strcat('job:',AttemptId,':',JobId),Time=Submitted,Component='Automation',Stage='Job submission',Level='Information',\r\n            Message=strcat('Seconds from observed dequeue to job submission: ',\r\n                coalesce(tostring(datetime_diff('millisecond',Submitted,Dequeued)/1000.0),'Not observed')),AttemptId,JobId),\n    (SelectedFailures\n        | project ParentId = 'eventgrid', Time = TimeGenerated, Component = 'EventGrid', Stage = FailureOutcome,\n            Level = 'Warning', Message = strcat('Subscription: ', EventSubscription, '\\n', Raw), AttemptId = '', JobId = ''),\n    (Selected | where isnotnull(EventTime) | distinct EventTime, EventType\n        | project ParentId = 'event', Time = EventTime, Component = 'Event payload', Stage = 'Producer timestamp (not delivery)',\n            Level = 'Information', Message = EventType, AttemptId = '', JobId = ''),\n    (Traces | where Message !startswith 'Trigger Details:' | join kind=inner SelectedInvocations on AttemptId\n        | project ParentId = strcat('function:', AttemptId), Time = TimeGenerated, Component = 'Function', Stage = tostring(Properties.Category),\n            Level = coalesce(tostring(Properties.LogLevel), 'Information'), Message, AttemptId, JobId = ''),\n    // Detail scans use the same shared resource parameters as the summary.\n    (AppExceptions | where TimeGenerated {TimeRange} | where AppRoleName =~ '{FunctionApp:name}'\n        | extend AttemptId = coalesce(tostring(Properties.InvocationId), extract(@'Id=([0-9a-fA-F-]{36})', 1, Message), OperationId)\n        | join kind=inner SelectedInvocations on AttemptId, OperationId\n        | project ParentId = strcat('function:', AttemptId), Time = TimeGenerated, Component = 'Function', Stage = 'Exception', Level = 'Error', Message = OuterMessage, AttemptId, JobId = ''),\n    (Streams | join kind=inner SelectedJobs on JobId\n        | project ParentId = strcat('job:', AttemptId, ':', JobId), Time = LogTime, Component = 'Runbook', Stage = Section, Level, Message, AttemptId, JobId),\n    (AzureDiagnostics | where TimeGenerated {TimeRange}\n        // Reuse the normalized leaf name so portal resource formatting cannot hide job children.\n        | where Category == 'JobLogs' and Resource =~ '{AutomationAccount:name}' and RunbookName_s =~ SelectedRunbookName\n        | extend JobId = tolower(tostring(JobId_g)) | join kind=inner SelectedJobs on JobId\n        | project ParentId = strcat('job:', AttemptId, ':', JobId), Time = TimeGenerated, Component = 'Automation', Stage = 'Job status',\n            Level = iff(ResultType in~ ('Failed', 'Stopped', 'Suspended'), 'Warning', 'Information'),\n            Message = ResultType, AttemptId, JobId)\n| order by Time asc, ParentId asc, Stage asc, Message asc\n| take 2000\n// Row numbers keep identical timestamps/messages distinct rather than colliding as tree IDs.\n| serialize RecordNumber = row_number()\n| project Id = strcat('record:', RecordNumber), ParentId,\n    // Time already has a dedicated column; use the node label for log origin instead.\n    Name = case(Component == 'Runbook', Stage, Component == 'Function', strcat('Function / ', Level), Stage),\n    Time, Component, Stage, FinalResult = case(Level =~ 'Error', 'failed', Level =~ 'Warning', 'warning', 'info'), Message, AttemptId, JobId;\nunion Parents, Records\n| order by Time asc, Id asc\n// Lead with the expandable result icon, keeping the node name beside it and IDs hidden.\n| project FinalResult, Name, Time, Component, Stage, Message, AttemptId, JobId, Id, ParentId",
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "formatters": [
                  {
                    "formatter": 5,
                    "columnMatch": "Id"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "ParentId"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "AttemptId"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "JobId"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "Component"
                  },
                  {
                    "formatter": 5,
                    "columnMatch": "Stage"
                  },
                  {
                    "formatter": 11,
                    "columnMatch": "FinalResult"
                  },
                  {
                    "formatOptions": {
                      "customColumnWidthSetting": "22ch"
                    },
                    "columnMatch": "Name",
                    "formatter": 1
                  },
                  {
                    "dateFormat": {
                      "formatName": "shortDateTimeNoMsPattern",
                      "showUtcTime": null
                    },
                    "formatOptions": {
                      "customColumnWidthSetting": "20ch"
                    },
                    "columnMatch": "Time",
                    "formatter": 6
                  },
                  {
                    "formatOptions": {
                      "customColumnWidthSetting": "50%"
                    },
                    "columnMatch": "Message",
                    "formatter": 1
                  }
                ],
                "rowLimit": 10000,
                "hierarchySettings": {
                  "expandTopLevel": true,
                  "treeType": 0,
                  "expanderColumn": "FinalResult",
                  "parentColumn": "ParentId",
                  "idColumn": "Id"
                }
              },
              "version": "KqlItem/1.0",
              "exportToExcelOptions": "all",
              "resourceType": "microsoft.operationalinsights/workspaces",
              "showExportToExcel": true,
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "crossComponentResources": [
                "{LogAnalyticsWorkspace}"
              ],
              "showExpandCollapseGrid": true,
              "title": "Selected event: execution tree (up to 2000 log records)"
            },
            "type": 3
          }
        ],
        "groupType": "editable",
        "version": "NotebookGroup/1.0"
      },
      "type": 12
    },
